#!/bin/bash
#PBS -N exp_e43
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=2:ngpus=1:mem=60gb
#PBS -l walltime=00:45:00
PY=$HOME/scratch/miniconda3/envs/amlc312/bin/python
E=/scratch/scai/mtech/aib262045/amlc_exp; B=/scratch/scai/mtech/aib262144/amlc_team/output_E16fr3; L=$E/lists
export AMLC_ROOT=/scratch/scai/mtech/aib262045/amlc_e10_0.005 OMP_NUM_THREADS=2 PYTHONPATH=$HOME/scratch/ber_gen_code/ber/src
cd $HOME/scratch/ber_gen_code/ber/src
$PY -u $HOME/scratch/exp/exp32.py $L || exit 1
for v in "T65 add_T65 empty" "T60 add_T60 empty" "T75 empty rem_T75" "T80 empty rem_T80"; do set -- $v
  $PY -u $HOME/scratch/exp/patch_tsv.py $B $E/out_E16fr3_fr$1 $L/$2.parquet $L/$3.parquet || exit 1
  (cd $E/student_resource && $PY utils/validate_submission.py --check-ids --test-dir dataset/test --matching $E/out_E16fr3_fr$1/matching_results.tsv --candidate $E/out_E16fr3_fr$1/candidate_pairs.tsv 2>&1 | grep -E "PASS|FAIL|rror")
  md5sum $E/out_E16fr3_fr$1/matching_results.tsv
  (cd $E && $PY compare.py $E/out_E16fr3_fr$1/matching_results.tsv $B/matching_results.tsv 2>&1 | grep -E "France")
done
echo "done $(date +%T)"
