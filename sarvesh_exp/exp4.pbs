#!/bin/bash
#PBS -N exp_variant4
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=120gb
#PBS -l walltime=00:40:00
PY=$HOME/scratch/miniconda3/envs/amlc312/bin/python
R=/scratch/scai/mtech/aib262045/amlc_exp
export AMLC_ROOT=$R OMP_NUM_THREADS=4 PYTHONPATH=$HOME/scratch/ber_gen_code/ber/src DFOLD=1
cd $HOME/scratch/ber_gen_code/ber/src
echo "===== E8: per-country thresholds (bge stack, US / India validation)"
$PY -u $HOME/scratch/exp/exp4.py
echo "===== E9: France base from the bge + LLM stack (_v10bplw) instead of the main stack; same 3 vetoes + fixes"
FROM=unlabelled:_a1pw:min,unlabelled:_a2pw:min,unlabelled:_a3pw:min RESTORE=restore_fr_dd REJECT=reject_fr_dd \
  $PY -u x_final.py $R/out_E9 _v10bplw 0.70 2>&1 | grep -E "^thr|restore|reject"
(cd $R/student_resource && $PY utils/validate_submission.py --check-ids --test-dir dataset/test --matching $R/out_E9/matching_results.tsv --candidate $R/out_E9/candidate_pairs.tsv 2>&1 | grep -E "PASS|FAIL")
md5sum $R/out_E9/matching_results.tsv
echo "done $(date +%T)"
