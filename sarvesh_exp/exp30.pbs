#!/bin/bash
#PBS -N exp_e41
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=2:ngpus=1:mem=90gb
#PBS -l walltime=00:45:00
PY=$HOME/scratch/miniconda3/envs/amlc312/bin/python
E=/scratch/scai/mtech/aib262045/amlc_exp; B=/scratch/scai/mtech/aib262144/amlc_team/output_E16fr3
export AMLC_ROOT=/scratch/scai/mtech/aib262045/amlc_e10_0.005 OMP_NUM_THREADS=2 PYTHONPATH=$HOME/scratch/ber_gen_code/ber/src DFOLD=1
mkdir -p $E/lists; cd $HOME/scratch/ber_gen_code/ber/src
$PY -u $HOME/scratch/exp/exp30.py $E/lists || exit 1
for v in F1 F2; do
  $PY -u $HOME/scratch/exp/patch_tsv.py $B $E/out_E16fr3_$v $E/lists/add_$v.parquet || exit 1
  (cd $E/student_resource && $PY utils/validate_submission.py --check-ids --test-dir dataset/test --matching $E/out_E16fr3_$v/matching_results.tsv --candidate $E/out_E16fr3_$v/candidate_pairs.tsv 2>&1 | grep -E "PASS|FAIL|rror")
  md5sum $E/out_E16fr3_$v/*.tsv
  (cd $E && $PY compare.py $E/out_E16fr3_$v/matching_results.tsv $B/matching_results.tsv 2>&1 | tail -4)
done
echo "done $(date +%T)"
