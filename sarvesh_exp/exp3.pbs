#!/bin/bash
#PBS -N exp_variant3
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=4:ngpus=1:mem=150gb
#PBS -l walltime=01:00:00
PY=$HOME/scratch/miniconda3/envs/amlc312/bin/python
R=/scratch/scai/mtech/aib262045/amlc_exp; X=$R/work/x
O=/scratch/scai/mtech/aib262144/AmazonMLChallenge/work
REF=/scratch/scai/mtech/aib262144/amlc_variant/output_variant_dd/matching_results.tsv
export AMLC_ROOT=$R OMP_NUM_THREADS=4 PYTHONPATH=$HOME/scratch/ber_gen_code/ber/src DFOLD=1
for f in imitated_train.npy; do [ -e $R/work/$f ] || ln -s $O/$f $R/work/$f; done
cd $HOME/scratch/ber_gen_code/ber/src
$PY -u $HOME/scratch/exp/exp3.py
ln -sfn $O/x/p5_test_v10b.parquet $X/p5_test_mean7.parquet
echo "===== E7: US / India from the mean of the bge and main LLM stacks; France as the variant"
FROM=unlabelled:_v10plw,unlabelled:_a1pw:min,unlabelled:_a2pw:min,unlabelled:_a3pw:min RESTORE=restore_fr_dd REJECT=reject_fr_dd \
  $PY -u x_final.py $R/out_E7 _mean7 0.70 2>&1 | grep -E "^thr"
(cd $R/student_resource && $PY utils/validate_submission.py --check-ids --test-dir dataset/test --matching $R/out_E7/matching_results.tsv --candidate $R/out_E7/candidate_pairs.tsv 2>&1 | grep -E "PASS|FAIL")
md5sum $R/out_E7/matching_results.tsv
echo "done $(date +%T)"
