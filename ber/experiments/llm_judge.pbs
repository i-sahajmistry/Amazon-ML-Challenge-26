#!/bin/bash
#PBS -N llm_judge
#PBS -P scai
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=4:mem=200gb
#PBS -l walltime=06:00:00
# LLM judge scores for a finished run: select the uncertain / ambiguous records, score their best candidates with a local
# open-weight LLM (one process per GPU PBS gave the job), merge. A gate runs first: 2,000 random labelled train pairs
# must reach judge AUC >= LLM_GATE_AUC (0.75), else the job stops before the long scoring. Then test (the submission
# needs it), then train (stage 2 learns the feature there; merge prints the judge's AUC per country).
# Logs: $RUNDIR/work/logs/llm_*.log
# Submit:  qsub ~/scratch/ber_llm/ber/experiments/llm_judge.pbs
#          qsub -v GATE_ONLY=1 ...                          (only the gate: prompts, scores, AUC; no files)
#          qsub -v RUNDIR=$HOME/scratch/amlc_loco_india,HOLDOUT=India,SPLITS=train ...   (the held-out-India run)
PY=${PY:-$HOME/scratch/miniconda3/envs/amlc312/bin/python}
set -ex -o pipefail
export AMLC_ROOT=${RUNDIR:-$HOME/scratch/amlc_v8} TAG=${TAG:-_v8} SEL=${SEL:-v4} HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export LLM_MODEL=${LLM_MODEL:-/scratch/scai/mtech/aib262045/models/Qwen3-8B}
[ -n "${HOLDOUT:-}" ] && export HOLDOUT
L=$AMLC_ROOT/work/logs
mkdir -p "$L" "$AMLC_ROOT/work/x"
nvidia-smi || true
cd "${CODE:-$HOME/scratch/ber_llm}/ber/src"
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then G=(${CUDA_VISIBLE_DEVICES//,/ }); else G=(""); fi
N=${#G[@]}
echo "GPUs: ${CUDA_VISIBLE_DEVICES:-unset} -> $N shard(s)"
SPL=${SPLITS:-test train}
for split in $SPL; do
    "$PY" -u llm_judge.py select "$split" 2>&1 | tee "$L/llm_select_$split.log"
done
# gate on labelled train pairs (needs the train selection; for a test-only run select train just for the gate)
[[ " $SPL " == *" train "* ]] || "$PY" -u llm_judge.py select train > "$L/llm_select_train_gate.log" 2>&1
${G[0]:+env CUDA_VISIBLE_DEVICES=${G[0]}} LLM_SMOKE=${GATE_N:-2000} "$PY" -u llm_judge.py score train \
    2>&1 | tee "$L/llm_gate.log" || { echo "the judge failed the gate, see $L/llm_gate.log"; exit 1; }
[ -n "${GATE_ONLY:-}" ] && exit 0
for split in $SPL; do
    pids=()
    for k in $(seq 0 $((N - 1))); do
        ${G[$k]:+env CUDA_VISIBLE_DEVICES=${G[$k]}} SHARD=$k NSHARD=$N \
            "$PY" -u llm_judge.py score "$split" > "$L/llm_score_${split}_$k.log" 2>&1 &
        pids+=($!)
    done
    for p in "${pids[@]}"; do wait "$p" || { echo "a scoring shard failed, see $L/llm_score_${split}_*.log"; exit 1; }; done
    "$PY" -u llm_judge.py merge "$split" 2>&1 | tee "$L/llm_merge_$split.log"
done
echo "llm judge done $(date +%T)"
