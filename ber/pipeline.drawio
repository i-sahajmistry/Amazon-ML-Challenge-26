        <mxCell id="st2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Stage 2 · LightGBM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;each record's best S1 only&lt;br&gt;+ entity context: other records claiming this S1, house-number peers&lt;br&gt;5 seeds · distractors weighted to 39%&lt;br&gt;→ q per record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
