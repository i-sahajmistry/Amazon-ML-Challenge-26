        </mxCell>
        <mxCell id="out" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;matching_results.tsv&lt;/font&gt;&lt;/b&gt;&lt;br&gt;one row per S1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1120" y="800" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="self" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Self-training · 3 rounds, no labels&lt;/font&gt;&lt;/b&gt;&lt;br&gt;pseudo-labels from these records' confident decisions&lt;br&gt;(round 1: stage 2's; round k: stage 2 vetoed by the rounds before k):&lt;br&gt;q ≥ 0.98: best S1 = match, other top-5 = non-match; q ≤ 0.02: no match&lt;br&gt;continue both cross-encoders (3M train + 4M pseudo pairs), re-run stages 1–2 → one veto stack per round" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="30" y="950" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="veto" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;3 veto stacks&lt;/font&gt;&lt;/b&gt;&lt;br&gt;all 4 stacks must pick&lt;br&gt;the same S1;&lt;br&gt;q = min of the 4 q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="440" y="965" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Same-address fixes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;restore (q := 1): same house number, the S1's street and core-name words, every added word spreads like true matches&lt;br&gt;reject (q := 0): accepted at the same address but adds a decoy-like word" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
