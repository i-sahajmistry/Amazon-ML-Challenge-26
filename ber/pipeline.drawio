        <mxCell id="feats" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pair features (62)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;bi-encoder cosine, ranks, gaps&lt;br&gt;rapidfuzz on names (full, core, skeleton), addresses&lt;br&gt;house numbers (integer-aware), token rarity&lt;br&gt;legal-form edits; name edits with per-country word statistics (from the records, no labels)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
