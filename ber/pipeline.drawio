        <mxCell id="dia" value="Country without&lt;br&gt;training labels?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(found from the data)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="45" y="785" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Decision&lt;/font&gt;&lt;/b&gt;&lt;br&gt;accept the record's best S1&lt;br&gt;if q ≥ 0.70 (every country)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
